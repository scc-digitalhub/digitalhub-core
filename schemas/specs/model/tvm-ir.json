{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "ArrayField" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/Serializable"
      },
      "title" : "array"
    },
    "BooleanField" : {
      "type" : "boolean",
      "title" : "boolean"
    },
    "Map_String.Serializable_" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/$defs/Serializable"
      }
    },
    "NumberField" : {
      "type" : "number",
      "title" : "number"
    },
    "ObjectField" : {
      "type" : "object",
      "title" : "object"
    },
    "Serializable" : {
      "anyOf" : [ {
        "$ref" : "#/$defs/StringField"
      }, {
        "$ref" : "#/$defs/NumberField"
      }, {
        "$ref" : "#/$defs/BooleanField"
      }, {
        "$ref" : "#/$defs/ObjectField"
      }, {
        "$ref" : "#/$defs/ArrayField"
      } ],
      "title" : "object"
    },
    "StringField" : {
      "type" : "string",
      "title" : "string"
    },
    "TvmFormat" : {
      "type" : "string",
      "enum" : [ "auto", "onnx", "tflite" ]
    },
    "TvmTensorSpec" : {
      "type" : "object",
      "properties" : {
        "dtype" : {
          "type" : "string",
          "title" : "Data Type",
          "description" : "Element type, e.g. float32 or int8."
        },
        "name" : {
          "type" : "string",
          "title" : "Name",
          "description" : "Tensor name."
        },
        "quantized_dimension" : {
          "type" : "integer",
          "title" : "Quantized Dimension",
          "description" : "Axis of per-axis quantization."
        },
        "scale" : {
          "title" : "Scale",
          "description" : "Quantization scale: real = (quantized - zero point) * scale.",
          "type" : "array",
          "items" : {
            "type" : "number",
            "title" : "fields.scale.item.title",
            "description" : "fields.scale.item.description"
          }
        },
        "shape" : {
          "title" : "Shape",
          "description" : "Dimensions, e.g. [1, 3, 640, 640].",
          "type" : "array",
          "items" : {
            "type" : "integer",
            "title" : "fields.shape.item.title",
            "description" : "fields.shape.item.description"
          }
        },
        "zero_point" : {
          "title" : "Zero Point",
          "description" : "Quantization zero point.",
          "type" : "array",
          "items" : {
            "type" : "integer",
            "title" : "fields.zeroPoint.item.title",
            "description" : "fields.zeroPoint.item.description"
          }
        }
      }
    }
  },
  "type" : "object",
  "properties" : {
    "algorithm" : {
      "type" : "string",
      "title" : "fields.algorithm.title",
      "description" : "fields.algorithm.description"
    },
    "entry" : {
      "type" : "string",
      "title" : "Entry Function",
      "description" : "Function of the model to call, usually main."
    },
    "framework" : {
      "type" : "string",
      "title" : "fields.framework.title",
      "description" : "fields.framework.description"
    },
    "inputs" : {
      "title" : "Inputs",
      "description" : "Input tensors of the model: name, data type, shape and, when quantized, scale and zero point.",
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/TvmTensorSpec",
        "title" : "fields.inputs.item.title",
        "description" : "fields.inputs.item.description"
      }
    },
    "keep_params_in_input" : {
      "type" : "boolean",
      "title" : "Keep Params in Input",
      "description" : "Whether the weights are kept apart in params.bin."
    },
    "outputs" : {
      "title" : "Outputs",
      "description" : "Output tensors of the model.",
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/TvmTensorSpec",
        "title" : "fields.outputs.item.title",
        "description" : "fields.outputs.item.description"
      }
    },
    "parameters" : {
      "$ref" : "#/$defs/Map_String.Serializable_",
      "title" : "Parameters",
      "description" : "Free-form extra information, e.g. the dataset or the export tool.",
      "additionalProperties" : {
        "$ref" : "#/$defs/Serializable",
        "title" : "fields.parameters.item.title",
        "description" : "fields.parameters.item.description"
      }
    },
    "path" : {
      "type" : "string",
      "title" : "fields.path.title",
      "description" : "fields.path.description",
      "minLength" : 1
    },
    "sanitize_input_names" : {
      "type" : "boolean",
      "title" : "Sanitize Input Names",
      "description" : "Whether the input names were rewritten into valid identifiers."
    },
    "source_format" : {
      "$ref" : "#/$defs/TvmFormat",
      "title" : "Source Format",
      "description" : "Format of the model the IR was converted from."
    }
  },
  "required" : [ "path" ],
  "title" : "specs.tvm-ir.title",
  "description" : "specs.tvm-ir.description"
}