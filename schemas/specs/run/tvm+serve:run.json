{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "CoreEnv" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "title" : "fields.name.title",
          "description" : "fields.name.description",
          "minLength" : 1
        },
        "value" : {
          "type" : "string",
          "title" : "fields.value.title",
          "description" : "fields.value.description",
          "minLength" : 1
        }
      },
      "required" : [ "name", "value" ]
    },
    "CoreResource" : {
      "type" : "object",
      "properties" : {
        "cpu" : {
          "type" : "string",
          "title" : "fields.k8s.resources.cpu.title",
          "description" : "fields.k8s.resources.cpu.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "disk" : {
          "type" : "string",
          "title" : "fields.k8s.resources.disk.title",
          "description" : "fields.k8s.resources.disk.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "gpu" : {
          "type" : "string",
          "title" : "fields.k8s.resources.gpu.title",
          "description" : "fields.k8s.resources.gpu.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "mem" : {
          "type" : "string",
          "title" : "fields.k8s.resources.memory.title",
          "description" : "fields.k8s.resources.memory.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        }
      }
    },
    "CoreServiceType" : {
      "type" : "string",
      "enum" : [ "ExternalName", "ClusterIP", "NodePort", "LoadBalancer" ]
    },
    "CoreVolume" : {
      "type" : "object",
      "properties" : {
        "mount_path" : {
          "type" : "string",
          "title" : "fields.mountPath.title",
          "description" : "fields.mountPath.description",
          "minLength" : 1
        },
        "name" : {
          "type" : "string",
          "title" : "fields.name.title",
          "description" : "fields.name.description",
          "minLength" : 1
        },
        "spec" : {
          "$ref" : "#/$defs/Map_String.String_",
          "title" : "fields.spec.title",
          "description" : "fields.spec.description",
          "additionalProperties" : {
            "type" : "string",
            "title" : "fields.spec.item.title",
            "description" : "fields.spec.item.description"
          }
        },
        "volume_type" : {
          "$ref" : "#/$defs/VolumeType",
          "title" : "fields.volumeType.title",
          "description" : "fields.volumeType.description"
        }
      },
      "required" : [ "mount_path", "name", "volume_type" ]
    },
    "Map_String.String_" : {
      "type" : "object",
      "additionalProperties" : {
        "type" : "string"
      }
    },
    "VolumeType" : {
      "type" : "string",
      "enum" : [ "shared_volume", "persistent_volume_claim", "ephemeral", "empty_dir", "image", "workflow_volume" ]
    }
  },
  "type" : "object",
  "properties" : {
    "image" : {
      "type" : "string",
      "title" : "Serve Image",
      "description" : "Image that serves the model; empty uses the serve image configured on the platform (Go)."
    },
    "inputs" : {
      "$ref" : "#/$defs/Map_String.String_",
      "title" : "fields.inputs.title",
      "description" : "fields.inputs.description",
      "additionalProperties" : {
        "type" : "string",
        "title" : "fields.inputs.item.title",
        "description" : "fields.inputs.item.description"
      }
    },
    "local_execution" : {
      "type" : "boolean",
      "title" : "fields.localExecution.title",
      "description" : "fields.localExecution.description"
    },
    "model_path" : {
      "type" : "string",
      "title" : "Compiled Model",
      "description" : "The tvm-so Model to serve; empty uses the one written by tvm+compile in the function.",
      "pattern" : "^(store://[^/]+/model/[^/]+/[^:]+(:.+)?)?$"
    },
    "replicas" : {
      "type" : "integer",
      "title" : "Replicas",
      "description" : "Number of pods that serve the model.",
      "minimum" : 0
    },
    "served_name" : {
      "type" : "string",
      "title" : "Served Model Name",
      "description" : "Name of the model in the API, /v2/models/<name>; empty uses the function name.",
      "pattern" : "^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?$"
    },
    "service_name" : {
      "type" : "string",
      "title" : "Service Name",
      "description" : "Extra Service name, <function>-<service name>."
    },
    "service_type" : {
      "$ref" : "#/$defs/CoreServiceType",
      "title" : "Service Type",
      "description" : "Kubernetes Service type: ClusterIP, NodePort or LoadBalancer.",
      "default" : "ClusterIP"
    },
    "task" : {
      "type" : "string",
      "title" : "fields.task.title",
      "description" : "fields.task.description",
      "minLength" : 1
    },
    "workers" : {
      "type" : "integer",
      "title" : "Workers",
      "description" : "Requests handled in parallel by each pod; each worker loads its own copy of the model.",
      "minimum" : 1
    }
  },
  "required" : [ "task" ],
  "title" : "specs.tvm+serve:run.title",
  "description" : "specs.tvm+serve:run.description",
  "allOf" : [ {
    "type" : "object",
    "properties" : {
      "envs" : {
        "title" : "fields.envs.title",
        "description" : "fields.envs.description",
        "type" : "array",
        "items" : {
          "$ref" : "#/$defs/CoreEnv",
          "title" : "fields.envs.item.title",
          "description" : "fields.envs.item.description"
        }
      },
      "function" : {
        "type" : "string",
        "title" : "fields.function.title",
        "description" : "fields.function.description",
        "minLength" : 1
      },
      "profile" : {
        "type" : "string",
        "title" : "fields.profile.title",
        "description" : "fields.profile.description"
      },
      "resources" : {
        "$ref" : "#/$defs/CoreResource",
        "title" : "fields.resources.title",
        "description" : "fields.resources.description"
      },
      "secrets" : {
        "title" : "fields.secrets.title",
        "description" : "fields.secrets.description",
        "type" : "array",
        "items" : {
          "type" : "string",
          "title" : "fields.secrets.item.title",
          "description" : "fields.secrets.item.description"
        }
      },
      "volumes" : {
        "title" : "fields.volumes.title",
        "description" : "fields.volumes.description",
        "type" : "array",
        "items" : {
          "$ref" : "#/$defs/CoreVolume",
          "title" : "fields.volumes.item.title",
          "description" : "fields.volumes.item.description"
        }
      }
    },
    "required" : [ "function" ],
    "title" : "specs.tvm+serve.title",
    "description" : "specs.tvm+serve.description"
  } ]
}