{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "ArrayField" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/Serializable"
      },
      "title" : "array"
    },
    "BooleanField" : {
      "type" : "boolean",
      "title" : "boolean"
    },
    "CoreEnv" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "title" : "fields.name.title",
          "description" : "fields.name.description",
          "minLength" : 1
        },
        "value" : {
          "type" : "string",
          "title" : "fields.value.title",
          "description" : "fields.value.description",
          "minLength" : 1
        }
      },
      "required" : [ "name", "value" ]
    },
    "CoreResource" : {
      "type" : "object",
      "properties" : {
        "cpu" : {
          "type" : "string",
          "title" : "fields.k8s.resources.cpu.title",
          "description" : "fields.k8s.resources.cpu.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "disk" : {
          "type" : "string",
          "title" : "fields.k8s.resources.disk.title",
          "description" : "fields.k8s.resources.disk.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "gpu" : {
          "type" : "string",
          "title" : "fields.k8s.resources.gpu.title",
          "description" : "fields.k8s.resources.gpu.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "mem" : {
          "type" : "string",
          "title" : "fields.k8s.resources.memory.title",
          "description" : "fields.k8s.resources.memory.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        }
      }
    },
    "CoreVolume" : {
      "type" : "object",
      "properties" : {
        "mount_path" : {
          "type" : "string",
          "title" : "fields.mountPath.title",
          "description" : "fields.mountPath.description",
          "minLength" : 1
        },
        "name" : {
          "type" : "string",
          "title" : "fields.name.title",
          "description" : "fields.name.description",
          "minLength" : 1
        },
        "spec" : {
          "$ref" : "#/$defs/Map_String.String_",
          "title" : "fields.spec.title",
          "description" : "fields.spec.description",
          "additionalProperties" : {
            "type" : "string",
            "title" : "fields.spec.item.title",
            "description" : "fields.spec.item.description"
          }
        },
        "volume_type" : {
          "$ref" : "#/$defs/VolumeType",
          "title" : "fields.volumeType.title",
          "description" : "fields.volumeType.description"
        }
      },
      "required" : [ "mount_path", "name", "volume_type" ]
    },
    "Map_String.Serializable_" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/$defs/Serializable"
      }
    },
    "Map_String.String_" : {
      "type" : "object",
      "additionalProperties" : {
        "type" : "string"
      }
    },
    "NumberField" : {
      "type" : "number",
      "title" : "number"
    },
    "ObjectField" : {
      "type" : "object",
      "title" : "object"
    },
    "Serializable" : {
      "anyOf" : [ {
        "$ref" : "#/$defs/StringField"
      }, {
        "$ref" : "#/$defs/NumberField"
      }, {
        "$ref" : "#/$defs/BooleanField"
      }, {
        "$ref" : "#/$defs/ObjectField"
      }, {
        "$ref" : "#/$defs/ArrayField"
      } ],
      "title" : "object"
    },
    "StringField" : {
      "type" : "string",
      "title" : "string"
    },
    "TvmTuningMode" : {
      "type" : "string",
      "enum" : [ "off", "tune", "apply" ]
    },
    "TvmTuningRunner" : {
      "type" : "string",
      "enum" : [ "local", "rpc" ]
    },
    "VolumeType" : {
      "type" : "string",
      "enum" : [ "shared_volume", "persistent_volume_claim", "ephemeral", "empty_dir", "image", "workflow_volume" ]
    }
  },
  "type" : "object",
  "properties" : {
    "image" : {
      "type" : "string",
      "title" : "Container Image",
      "description" : "Image of the compile Job; empty uses the TVM toolkit image configured on the platform."
    },
    "inputs" : {
      "$ref" : "#/$defs/Map_String.String_",
      "title" : "fields.inputs.title",
      "description" : "fields.inputs.description",
      "additionalProperties" : {
        "type" : "string",
        "title" : "fields.inputs.item.title",
        "description" : "fields.inputs.item.description"
      }
    },
    "local_execution" : {
      "type" : "boolean",
      "title" : "fields.localExecution.title",
      "description" : "fields.localExecution.description"
    },
    "model_path" : {
      "type" : "string",
      "title" : "IR Model",
      "description" : "Explicit IR override. Empty uses function.ir_model. Example: store://my-project/model/tvm-ir/xinet-ir:version."
    },
    "optimization" : {
      "type" : "object",
      "properties" : {
        "benchmark_runs" : {
          "type" : "integer",
          "title" : "Benchmark Runs",
          "description" : "Timed inferences after compilation; 0 disables them. Example: 10.",
          "default" : 10,
          "minimum" : 0
        },
        "cross_cc" : {
          "type" : "string",
          "title" : "Cross Compiler",
          "description" : "C++ compiler used to link model.so; empty selects it from the target. ARM64 example: aarch64-linux-gnu-g++."
        },
        "cross_cc_options" : {
          "title" : "Compiler Options",
          "description" : "Use profile defaults, or replace them with separate compiler arguments. Example item: --sysroot=/opt/sysroots/arm64.",
          "default" : null,
          "oneOf" : [ {
            "type" : "null",
            "title" : "Profile defaults"
          }, {
            "type" : "array",
            "title" : "Custom arguments",
            "items" : {
              "type" : "string"
            }
          } ]
        },
        "exec_mode" : {
          "type" : "string",
          "title" : "Execution Mode",
          "description" : "Relax VM graph execution: bytecode or compiled. Example: compiled generates native graph code.",
          "default" : "bytecode",
          "enum" : [ "bytecode", "compiled" ]
        },
        "opt_level" : {
          "type" : "integer",
          "title" : "Optimization Level",
          "description" : "TVM optimization level, from 0 to 3. Example: 3.",
          "default" : 3,
          "minimum" : 0,
          "maximum" : 3
        },
        "params_path" : {
          "type" : "string",
          "title" : "Parameters File",
          "description" : "Optional weights file inside the Job. Example: /shared/input/params.bin; empty detects it next to the IR."
        },
        "relax_pipeline" : {
          "type" : "string",
          "title" : "Relax Pipeline",
          "description" : "Named graph optimization pipeline. Example: default. Enable MetaSchedule with tuning_mode.",
          "default" : "default"
        },
        "system_lib" : {
          "type" : "boolean",
          "title" : "System Library",
          "description" : "Self-registering library for static linking; not supported by the serve images. Example: false.",
          "default" : false
        },
        "target_num_cores" : {
          "type" : "integer",
          "title" : "Target Number of Cores",
          "description" : "Cores of the target CPU, or the LLVM host for CUDA; empty uses the Job CPU request. Example: 4 for a Raspberry Pi 5.",
          "minimum" : 1
        },
        "tir_pipeline" : {
          "type" : "string",
          "title" : "TIR Pipeline",
          "description" : "Named low-level compilation pipeline. Example: default.",
          "default" : "default"
        }
      },
      "title" : "Advanced compilation",
      "description" : "fields.optimization.description"
    },
    "tag" : {
      "type" : "string",
      "title" : "Tag",
      "description" : "Suffix of the compiled Model name. Example: x86 or pi5; use one per target."
    },
    "target" : {
      "type" : "object",
      "title" : "Explicit TVM Target",
      "properties" : {
        "kind" : {
          "type" : "string",
          "enum" : [ "llvm", "cuda" ]
        }
      },
      "dependencies" : {
        "kind" : {
          "oneOf" : [ {
            "type" : "object",
            "properties" : {
              "kind" : {
                "enum" : [ "llvm" ]
              },
              "mtriple" : {
                "type" : "string"
              },
              "mcpu" : {
                "type" : "string"
              },
              "mfloat-abi" : {
                "type" : "string"
              },
              "mattr" : {
                "type" : "array",
                "items" : {
                  "type" : "string"
                }
              },
              "num-cores" : {
                "type" : "integer",
                "minimum" : 1
              }
            }
          }, {
            "type" : "object",
            "properties" : {
              "kind" : {
                "enum" : [ "cuda" ]
              },
              "arch" : {
                "type" : "string",
                "pattern" : "^sm_[0-9]+[a-z]?$",
                "description" : "Explicit CUDA architecture, for example sm_87 or sm_90a."
              },
              "host" : {
                "type" : "object",
                "title" : "LLVM host target",
                "properties" : {
                  "kind" : {
                    "type" : "string",
                    "const" : "llvm"
                  },
                  "mtriple" : {
                    "type" : "string",
                    "pattern" : "^(x86_64|amd64|aarch64|arm64)(-[A-Za-z0-9_+.]+)*-linux-gnu$",
                    "description" : "Explicit AMD64 or ARM64 Linux GNU host triple, for example aarch64-linux-gnu."
                  },
                  "mcpu" : {
                    "type" : "string"
                  },
                  "mfloat-abi" : {
                    "type" : "string"
                  },
                  "mattr" : {
                    "type" : "array",
                    "items" : {
                      "type" : "string"
                    }
                  },
                  "num-cores" : {
                    "type" : "integer",
                    "minimum" : 1
                  }
                },
                "required" : [ "kind", "mtriple" ],
                "additionalProperties" : true
              },
              "max_shared_memory_per_block" : {
                "type" : "integer",
                "minimum" : 1,
                "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
              },
              "max_threads_per_block" : {
                "type" : "integer",
                "minimum" : 1,
                "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
              },
              "thread_warp_size" : {
                "type" : "integer",
                "minimum" : 1,
                "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
              }
            },
            "required" : [ "arch", "host" ]
          } ]
        }
      },
      "dependentSchemas" : {
        "kind" : {
          "oneOf" : [ {
            "type" : "object",
            "properties" : {
              "kind" : {
                "enum" : [ "llvm" ]
              },
              "mtriple" : {
                "type" : "string"
              },
              "mcpu" : {
                "type" : "string"
              },
              "mfloat-abi" : {
                "type" : "string"
              },
              "mattr" : {
                "type" : "array",
                "items" : {
                  "type" : "string"
                }
              },
              "num-cores" : {
                "type" : "integer",
                "minimum" : 1
              }
            }
          }, {
            "type" : "object",
            "properties" : {
              "kind" : {
                "enum" : [ "cuda" ]
              },
              "arch" : {
                "type" : "string",
                "pattern" : "^sm_[0-9]+[a-z]?$",
                "description" : "Explicit CUDA architecture, for example sm_87 or sm_90a."
              },
              "host" : {
                "type" : "object",
                "title" : "LLVM host target",
                "properties" : {
                  "kind" : {
                    "type" : "string",
                    "const" : "llvm"
                  },
                  "mtriple" : {
                    "type" : "string",
                    "pattern" : "^(x86_64|amd64|aarch64|arm64)(-[A-Za-z0-9_+.]+)*-linux-gnu$",
                    "description" : "Explicit AMD64 or ARM64 Linux GNU host triple, for example aarch64-linux-gnu."
                  },
                  "mcpu" : {
                    "type" : "string"
                  },
                  "mfloat-abi" : {
                    "type" : "string"
                  },
                  "mattr" : {
                    "type" : "array",
                    "items" : {
                      "type" : "string"
                    }
                  },
                  "num-cores" : {
                    "type" : "integer",
                    "minimum" : 1
                  }
                },
                "required" : [ "kind", "mtriple" ],
                "additionalProperties" : true
              },
              "max_shared_memory_per_block" : {
                "type" : "integer",
                "minimum" : 1,
                "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
              },
              "max_threads_per_block" : {
                "type" : "integer",
                "minimum" : 1,
                "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
              },
              "thread_warp_size" : {
                "type" : "integer",
                "minimum" : 1,
                "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
              }
            },
            "required" : [ "arch", "host" ]
          } ]
        }
      },
      "allOf" : [ {
        "if" : {
          "required" : [ "kind" ],
          "properties" : {
            "kind" : {
              "const" : "cuda"
            }
          }
        },
        "then" : {
          "type" : "object",
          "properties" : {
            "arch" : {
              "type" : "string",
              "pattern" : "^sm_[0-9]+[a-z]?$",
              "description" : "Explicit CUDA architecture, for example sm_87 or sm_90a."
            },
            "max_shared_memory_per_block" : {
              "type" : "integer",
              "minimum" : 1,
              "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
            },
            "max_threads_per_block" : {
              "type" : "integer",
              "minimum" : 1,
              "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
            },
            "thread_warp_size" : {
              "type" : "integer",
              "minimum" : 1,
              "description" : "Real device limit required for CUDA tuning; obtain it from the target GPU."
            },
            "host" : {
              "type" : "object",
              "properties" : {
                "kind" : {
                  "type" : "string",
                  "const" : "llvm"
                },
                "mtriple" : {
                  "type" : "string",
                  "pattern" : "^(x86_64|amd64|aarch64|arm64)(-[A-Za-z0-9_+.]+)*-linux-gnu$",
                  "description" : "Explicit AMD64 or ARM64 Linux GNU host triple, for example aarch64-linux-gnu."
                },
                "mcpu" : {
                  "type" : "string"
                },
                "mfloat-abi" : {
                  "type" : "string"
                },
                "mattr" : {
                  "type" : "array",
                  "items" : {
                    "type" : "string"
                  }
                },
                "num-cores" : {
                  "type" : "integer",
                  "minimum" : 1
                }
              },
              "required" : [ "kind", "mtriple" ]
            }
          },
          "required" : [ "arch", "host" ]
        }
      } ],
      "if" : {
        "minProperties" : 1
      },
      "then" : {
        "required" : [ "kind" ]
      },
      "additionalProperties" : true,
      "description" : "Optional standard TVM LLVM or CUDA target; leave the profile at auto. CUDA requires arch and a nested LLVM host with an explicit AMD64 or ARM64 Linux GNU mtriple."
    },
    "target_architecture" : {
      "type" : "string",
      "title" : "Target profile",
      "default" : "auto",
      "oneOf" : [ {
        "const" : "auto",
        "title" : "Compile node CPU - generic"
      }, {
        "const" : "amd64",
        "title" : "Intel/AMD 64-bit - x86-64-v2"
      }, {
        "const" : "amd64_v3",
        "title" : "Intel/AMD 64-bit - x86-64-v3 (AVX2)"
      }, {
        "const" : "amd64_native",
        "title" : "Intel/AMD 64-bit - compile node CPU (native)"
      }, {
        "const" : "arm64",
        "title" : "ARM 64-bit - generic (AArch64)"
      }, {
        "const" : "arm64_pi5",
        "title" : "Raspberry Pi 5 - ARM 64-bit (Cortex-A76)"
      }, {
        "const" : "arm32",
        "title" : "ARM 32-bit - ARMv7 (hard-float, NEON)"
      }, {
        "const" : "jetson_orin_cuda",
        "title" : "NVIDIA Jetson Orin - CUDA (sm_87), ARM64 host"
      }, {
        "const" : "cpu",
        "title" : "cpu (alias of auto)"
      }, {
        "const" : "llvm",
        "title" : "llvm (alias of auto)"
      }, {
        "const" : "x86",
        "title" : "x86 (alias of amd64)"
      }, {
        "const" : "x86_v3",
        "title" : "x86_v3 (alias of amd64_v3)"
      }, {
        "const" : "x86_native",
        "title" : "x86_native (alias of amd64_native)"
      }, {
        "const" : "armv7l",
        "title" : "armv7l (alias of arm32)"
      } ]
    },
    "task" : {
      "type" : "string",
      "title" : "fields.task.title",
      "description" : "fields.task.description",
      "minLength" : 1
    },
    "tuning" : {
      "type" : "object",
      "title" : "MetaSchedule tuning",
      "properties" : {
        "tuning_mode" : {
          "$ref" : "#/$defs/TvmTuningMode",
          "title" : "Tuning Mode",
          "description" : "off ignores tuning settings without deleting them; tune searches schedules; apply reuses a database.",
          "default" : "off"
        },
        "tuning_model_path" : { },
        "tuning_ops" : { },
        "allow_partial_tuning" : { },
        "tuning_trials" : { },
        "max_trials_per_task" : { },
        "tuning_trials_per_iter" : { },
        "tuning_runner" : { },
        "tuning_workers" : { },
        "tuning_seed" : { },
        "tuning_number" : { },
        "tuning_repeat" : { },
        "tuning_min_repeat_ms" : { },
        "tuning_alloc_repeat" : { },
        "tuning_enable_cpu_cache_flush" : { },
        "tuning_builder_timeout_sec" : { },
        "tuning_runner_timeout_sec" : { },
        "rpc_tracker_host" : { },
        "rpc_tracker_port" : { },
        "rpc_tracker_key" : { },
        "rpc_session_timeout_sec" : { }
      },
      "additionalProperties" : false,
      "dependentSchemas" : {
        "tuning_mode" : {
          "oneOf" : [ {
            "type" : "object",
            "properties" : {
              "tuning_mode" : {
                "enum" : [ "off" ]
              }
            }
          }, {
            "type" : "object",
            "properties" : {
              "tuning_model_path" : {
                "type" : "string",
                "title" : "Tuning Database Source",
                "description" : "Compiled Model containing the tuning database; required with apply. Example: store://my-project/model/tvm-so/xinet-tuned:version."
              },
              "tuning_ops" : {
                "title" : "Operator Names",
                "description" : "Optional filters on task names; empty tunes all. Example item: conv2d.",
                "type" : "array",
                "items" : {
                  "type" : "string",
                  "title" : "fields.tuningOps.item.title",
                  "description" : "fields.tuningOps.item.description"
                }
              },
              "allow_partial_tuning" : {
                "type" : "boolean",
                "title" : "Allow Partial Tuning",
                "description" : "Allow incomplete task coverage, for quick tests only. Example: false.",
                "default" : false
              },
              "tuning_trials" : {
                "type" : "integer",
                "title" : "Max Trials (Global)",
                "description" : "Global search budget, required with tune. Example: 2000; the required budget depends on the model.",
                "minimum" : 1
              },
              "max_trials_per_task" : {
                "type" : "integer",
                "title" : "Max Trials Per Task",
                "description" : "Maximum candidates measured per task. Example: 16.",
                "default" : 16,
                "minimum" : 1
              },
              "tuning_trials_per_iter" : {
                "type" : "integer",
                "title" : "Trials Per Iteration",
                "description" : "Candidates measured per task in one round. Example: 64, capped by max_trials_per_task.",
                "default" : 64,
                "minimum" : 1
              },
              "tuning_runner" : {
                "$ref" : "#/$defs/TvmTuningRunner",
                "title" : "Runner",
                "description" : "local measures on the Job; rpc measures on a remote target. Example: rpc for a Raspberry Pi cross-compile.",
                "default" : "local"
              },
              "tuning_workers" : {
                "type" : "integer",
                "title" : "Max Workers",
                "description" : "Parallel compiler workers; default is the requested Job cores for CPU and 1 for CUDA. CUDA measurements remain sequential.",
                "minimum" : 1
              },
              "tuning_seed" : {
                "type" : "integer",
                "title" : "Random Seed",
                "description" : "Random seed for the search. Example: 0.",
                "default" : 0,
                "minimum" : 0
              },
              "tuning_number" : {
                "type" : "integer",
                "title" : "Runs Per Repeat",
                "description" : "Inference runs averaged into each measurement. Example: 3.",
                "default" : 3,
                "minimum" : 1
              },
              "tuning_repeat" : {
                "type" : "integer",
                "title" : "Measurement Repeats",
                "description" : "Independent measurements per candidate. Example: 1.",
                "default" : 1,
                "minimum" : 1
              },
              "tuning_min_repeat_ms" : {
                "type" : "integer",
                "title" : "Min Repeat Time (ms)",
                "description" : "Minimum measurement duration in milliseconds. Example: 100.",
                "default" : 100,
                "minimum" : 0
              },
              "tuning_alloc_repeat" : {
                "type" : "integer",
                "title" : "Allocation Repeats",
                "description" : "Random input allocations per candidate. Example: 1.",
                "default" : 1,
                "minimum" : 1
              },
              "tuning_enable_cpu_cache_flush" : {
                "type" : "boolean",
                "title" : "Flush CPU Cache",
                "description" : "Flush CPU caches before measurements. Example: false.",
                "default" : false
              },
              "tuning_builder_timeout_sec" : {
                "type" : "number",
                "title" : "Builder Timeout (s)",
                "description" : "Maximum seconds to compile one candidate. Example: 30.",
                "default" : 30.0,
                "exclusiveMinimum" : 0.0
              },
              "tuning_mode" : {
                "enum" : [ "tune" ]
              }
            },
            "if" : {
              "required" : [ "tuning_runner" ],
              "properties" : {
                "tuning_runner" : {
                  "const" : "rpc"
                }
              }
            },
            "then" : {
              "type" : "object",
              "properties" : {
                "rpc_tracker_host" : {
                  "type" : "string",
                  "pattern" : "\\S",
                  "title" : "RPC Tracker Host",
                  "description" : "TVM RPC tracker address. Example: 192.168.1.50; use your tracker host."
                },
                "rpc_tracker_port" : {
                  "type" : "integer",
                  "title" : "RPC Tracker Port",
                  "description" : "TVM RPC tracker port. Example: 9190; must match your tracker.",
                  "minimum" : 1,
                  "maximum" : 65535
                },
                "rpc_tracker_key" : {
                  "type" : "string",
                  "pattern" : "\\S",
                  "title" : "RPC Tracker Key",
