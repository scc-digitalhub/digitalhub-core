{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "ArrayField" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/Serializable"
      },
      "title" : "array"
    },
    "BooleanField" : {
      "type" : "boolean",
      "title" : "boolean"
    },
    "CoreEnv" : {
      "type" : "object",
      "properties" : {
        "name" : {
          "type" : "string",
          "title" : "fields.name.title",
          "description" : "fields.name.description",
          "minLength" : 1
        },
        "value" : {
          "type" : "string",
          "title" : "fields.value.title",
          "description" : "fields.value.description",
          "minLength" : 1
        }
      },
      "required" : [ "name", "value" ]
    },
    "CoreResource" : {
      "type" : "object",
      "properties" : {
        "cpu" : {
          "type" : "string",
          "title" : "fields.k8s.resources.cpu.title",
          "description" : "fields.k8s.resources.cpu.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "disk" : {
          "type" : "string",
          "title" : "fields.k8s.resources.disk.title",
          "description" : "fields.k8s.resources.disk.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "gpu" : {
          "type" : "string",
          "title" : "fields.k8s.resources.gpu.title",
          "description" : "fields.k8s.resources.gpu.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        },
        "mem" : {
          "type" : "string",
          "title" : "fields.k8s.resources.memory.title",
          "description" : "fields.k8s.resources.memory.description",
          "pattern" : "^\\d+([a-zA-Z]+)?$"
        }
      }
    },
    "CoreVolume" : {
      "type" : "object",
      "properties" : {
        "mount_path" : {
          "type" : "string",
          "title" : "fields.mountPath.title",
          "description" : "fields.mountPath.description",
          "minLength" : 1
        },
        "name" : {
          "type" : "string",
          "title" : "fields.name.title",
          "description" : "fields.name.description",
          "minLength" : 1
        },
        "spec" : {
          "$ref" : "#/$defs/Map_String.String_",
          "title" : "fields.spec.title",
          "description" : "fields.spec.description",
          "additionalProperties" : {
            "type" : "string",
            "title" : "fields.spec.item.title",
            "description" : "fields.spec.item.description"
          }
        },
        "volume_type" : {
          "$ref" : "#/$defs/VolumeType",
          "title" : "fields.volumeType.title",
          "description" : "fields.volumeType.description"
        }
      },
      "required" : [ "mount_path", "name", "volume_type" ]
    },
    "Map_String.Serializable_" : {
      "type" : "object",
      "additionalProperties" : {
        "$ref" : "#/$defs/Serializable"
      }
    },
    "Map_String.String_" : {
      "type" : "object",
      "additionalProperties" : {
        "type" : "string"
      }
    },
    "NumberField" : {
      "type" : "number",
      "title" : "number"
    },
    "ObjectField" : {
      "type" : "object",
      "title" : "object"
    },
    "Serializable" : {
      "anyOf" : [ {
        "$ref" : "#/$defs/StringField"
      }, {
        "$ref" : "#/$defs/NumberField"
      }, {
        "$ref" : "#/$defs/BooleanField"
      }, {
        "$ref" : "#/$defs/ObjectField"
      }, {
        "$ref" : "#/$defs/ArrayField"
      } ],
      "title" : "object"
    },
    "StringField" : {
      "type" : "string",
      "title" : "string"
    },
    "TvmTuningMode" : {
      "type" : "string",
      "enum" : [ "off", "tune", "apply" ]
    },
    "TvmTuningRunner" : {
      "type" : "string",
      "enum" : [ "local", "rpc" ]
    },
    "VolumeType" : {
      "type" : "string",
      "enum" : [ "shared_volume", "persistent_volume_claim", "ephemeral", "empty_dir", "image", "workflow_volume" ]
    }
  },
  "type" : "object",
  "properties" : {
    "image" : {
      "type" : "string",
      "title" : "Container Image",
      "description" : "Image of the compile Job; empty uses the TVM toolkit image configured on the platform."
    },
    "inputs" : {
      "$ref" : "#/$defs/Map_String.String_",
      "title" : "fields.inputs.title",
      "description" : "fields.inputs.description",
      "additionalProperties" : {
        "type" : "string",
        "title" : "fields.inputs.item.title",
        "description" : "fields.inputs.item.description"
      }
    },
    "local_execution" : {
      "type" : "boolean",
      "title" : "fields.localExecution.title",
      "description" : "fields.localExecution.description"
    },
    "model_path" : {
      "type" : "string",
      "title" : "IR Model",
      "description" : "Explicit IR override. Empty uses function.ir_model. Example: store://my-project/model/tvm-ir/xinet-ir:version."
    },
    "tag" : {
      "type" : "string",
      "title" : "Tag",
      "description" : "Suffix of the compiled Model name. Example: x86 or pi5; use one per target."
    },
    "target" : {
      "type" : "object",
      "title" : "Explicit TVM Target",
      "properties" : {
        "kind" : {
          "type" : "string",
          "pattern" : "^llvm$"
        }
      },
      "dependencies" : {
        "kind" : {
          "properties" : {
            "mtriple" : {
              "type" : "string"
            },
            "mcpu" : {
              "type" : "string"
            },
            "mfloat-abi" : {
              "type" : "string"
            },
            "mattr" : {
              "type" : "array",
              "items" : {
                "type" : "string"
              }
            },
            "num-cores" : {
              "type" : "integer",
              "minimum" : 1
            }
          }
        }
      },
      "if" : {
        "minProperties" : 1
      },
      "then" : {
        "required" : [ "kind" ]
      },
      "additionalProperties" : true,
      "description" : "Optional standard TVM LLVM target; leave the profile at auto. Example: kind=llvm, mtriple=aarch64-linux-gnu, mcpu=cortex-a72."
    },
    "target_architecture" : {
      "type" : "string",
      "title" : "Target CPU Profile",
      "default" : "auto",
      "oneOf" : [ {
        "const" : "auto",
        "title" : "Compile node CPU - generic"
      }, {
        "const" : "amd64",
        "title" : "Intel/AMD 64-bit - x86-64-v2"
      }, {
        "const" : "amd64_v3",
        "title" : "Intel/AMD 64-bit - x86-64-v3 (AVX2)"
      }, {
        "const" : "amd64_native",
        "title" : "Intel/AMD 64-bit - compile node CPU (native)"
      }, {
        "const" : "arm64",
        "title" : "ARM 64-bit - generic (AArch64)"
      }, {
        "const" : "arm64_pi5",
        "title" : "Raspberry Pi 5 - ARM 64-bit (Cortex-A76)"
      }, {
        "const" : "arm32",
        "title" : "ARM 32-bit - ARMv7 (hard-float, NEON)"
      } ]
    },
    "task" : {
      "type" : "string",
      "title" : "fields.task.title",
      "description" : "fields.task.description",
      "minLength" : 1
    },
    "optimization" : {
      "type" : "object",
      "title" : "Advanced compilation",
      "properties" : {
        "target_num_cores" : {
          "type" : "integer",
          "title" : "Target Number of Cores",
          "description" : "Cores of the target CPU; empty uses the Job CPU request. Example: 4 for a Raspberry Pi 5.",
          "minimum" : 1
        },
        "opt_level" : {
          "type" : "integer",
          "title" : "Optimization Level",
          "description" : "TVM optimization level, from 0 to 3. Example: 3.",
          "default" : 3,
          "minimum" : 0,
          "maximum" : 3
        },
        "cross_cc" : {
          "type" : "string",
          "title" : "Cross Compiler",
          "description" : "C++ compiler used to link model.so; empty selects it from the target. ARM64 example: aarch64-linux-gnu-g++."
        },
        "cross_cc_options" : {
          "title" : "Compiler Options",
          "description" : "Use profile defaults, or replace them with separate compiler arguments. Example item: --sysroot=/opt/sysroots/arm64.",
          "default" : null,
          "oneOf" : [ {
            "type" : "null",
            "title" : "Profile defaults"
          }, {
            "type" : "array",
            "title" : "Custom arguments",
            "items" : {
              "type" : "string"
            }
          } ]
        },
        "exec_mode" : {
          "type" : "string",
          "title" : "Execution Mode",
          "description" : "Relax VM graph execution: bytecode or compiled. Example: compiled generates native graph code.",
          "default" : "bytecode",
          "enum" : [ "bytecode", "compiled" ]
        },
        "relax_pipeline" : {
          "type" : "string",
          "title" : "Relax Pipeline",
          "description" : "Named graph optimization pipeline. Example: default. Enable MetaSchedule with tuning_mode.",
          "default" : "default"
        },
        "tir_pipeline" : {
          "type" : "string",
          "title" : "TIR Pipeline",
          "description" : "Named low-level compilation pipeline. Example: default.",
          "default" : "default"
        },
        "system_lib" : {
          "type" : "boolean",
          "title" : "System Library",
          "description" : "Self-registering library for static linking; not supported by the serve images. Example: false.",
          "default" : false
        },
        "benchmark_runs" : {
          "type" : "integer",
          "title" : "Benchmark Runs",
          "description" : "Timed inferences after compilation; 0 disables them. Example: 10.",
          "default" : 10,
          "minimum" : 0
        },
        "params_path" : {
          "type" : "string",
          "title" : "Parameters File",
          "description" : "Optional weights file inside the Job. Example: /shared/input/params.bin; empty detects it next to the IR."
        }
      }
    },
    "tuning" : {
      "type" : "object",
      "title" : "MetaSchedule tuning",
      "properties" : {
        "tuning_mode" : {
          "$ref" : "#/$defs/TvmTuningMode",
          "title" : "Tuning Mode",
          "description" : "off ignores tuning settings without deleting them; tune searches schedules; apply reuses a database.",
          "default" : "off"
        }
      },
      "dependencies" : {
        "tuning_mode" : {
          "oneOf" : [ {
            "type" : "object",
            "properties" : {
              "tuning_mode" : {
                "enum" : [ "off" ]
              }
            }
          }, {
            "type" : "object",
            "properties" : {
              "tuning_model_path" : {
                "allOf" : [ {
                  "type" : "string"
                }, {
                  "title" : "Tuning Database Source",
                  "description" : "Compiled Model containing the tuning database; required with apply. Example: store://my-project/model/tvm-so/xinet-tuned:version."
                } ]
              },
              "tuning_ops" : {
                "title" : "Operator Names",
                "description" : "Optional filters on task names; empty tunes all. Example item: conv2d.",
                "type" : "array",
                "items" : {
                  "allOf" : [ {
                    "type" : "string"
                  }, {
                    "title" : "fields.tuningOps.item.title",
                    "description" : "fields.tuningOps.item.description"
                  } ]
                }
              },
              "allow_partial_tuning" : {
                "allOf" : [ {
                  "type" : "boolean"
                }, {
                  "title" : "Allow Partial Tuning",
                  "description" : "Allow incomplete task coverage, for quick tests only. Example: false.",
                  "default" : false
                } ]
              },
              "tuning_trials" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Max Trials (Global)",
                  "description" : "Global search budget, required with tune. Example: 2000; the required budget depends on the model.",
                  "minimum" : 1
                } ]
              },
              "max_trials_per_task" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Max Trials Per Task",
                  "description" : "Maximum candidates measured per task. Example: 16.",
                  "default" : 16,
                  "minimum" : 1
                } ]
              },
              "tuning_trials_per_iter" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Trials Per Iteration",
                  "description" : "Candidates measured per task in one round. Example: 64, capped by max_trials_per_task.",
                  "default" : 64,
                  "minimum" : 1
                } ]
              },
              "tuning_runner" : {
                "allOf" : [ {
                  "$ref" : "#/$defs/TvmTuningRunner"
                }, {
                  "title" : "Runner",
                  "description" : "local measures on the Job; rpc measures on a remote target. Example: rpc for a Raspberry Pi cross-compile.",
                  "default" : "local"
                } ]
              },
              "tuning_workers" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Max Workers",
                  "description" : "Parallel compiler workers; empty uses requested Job cores. Example: 2 with a 2-core Job.",
                  "minimum" : 1
                } ]
              },
              "tuning_seed" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Random Seed",
                  "description" : "Random seed for the search. Example: 0.",
                  "default" : 0,
                  "minimum" : 0
                } ]
              },
              "tuning_number" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Runs Per Repeat",
                  "description" : "Inference runs averaged into each measurement. Example: 3.",
                  "default" : 3,
                  "minimum" : 1
                } ]
              },
              "tuning_repeat" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Measurement Repeats",
                  "description" : "Independent measurements per candidate. Example: 1.",
                  "default" : 1,
                  "minimum" : 1
                } ]
              },
              "tuning_min_repeat_ms" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Min Repeat Time (ms)",
                  "description" : "Minimum measurement duration in milliseconds. Example: 100.",
                  "default" : 100,
                  "minimum" : 0
                } ]
              },
              "tuning_alloc_repeat" : {
                "allOf" : [ {
                  "type" : "integer"
                }, {
                  "title" : "Allocation Repeats",
                  "description" : "Random input allocations per candidate. Example: 1.",
                  "default" : 1,
                  "minimum" : 1
                } ]
              },
              "tuning_enable_cpu_cache_flush" : {
                "allOf" : [ {
                  "type" : "boolean"
                }, {
                  "title" : "Flush CPU Cache",
                  "description" : "Flush CPU caches before measurements. Example: false.",
                  "default" : false
                } ]
              },
              "tuning_builder_timeout_sec" : {
                "allOf" : [ {
                  "type" : "number"
                }, {
                  "title" : "Builder Timeout (s)",
                  "description" : "Maximum seconds to compile one candidate. Example: 30.",
                  "default" : 30.0,
                  "exclusiveMinimum" : 0.0
                } ]
              },
              "tuning_mode" : {
                "enum" : [ "tune" ]
              }
            },
            "if" : {
              "required" : [ "tuning_runner" ],
              "properties" : {
                "tuning_runner" : {
                  "const" : "rpc"
                }
              }
            },
            "then" : {
              "type" : "object",
              "properties" : {
                "rpc_tracker_host" : {
                  "allOf" : [ {
                    "type" : "string"
                  }, {
                    "title" : "RPC Tracker Host",
                    "description" : "TVM RPC tracker address. Example: 192.168.1.50; use your tracker host."
                  } ]
                },
                "rpc_tracker_port" : {
                  "allOf" : [ {
                    "type" : "integer"
                  }, {
                    "title" : "RPC Tracker Port",
                    "description" : "TVM RPC tracker port. Example: 9190; must match your tracker.",
                    "minimum" : 1,
                    "maximum" : 65535
                  } ]
                },
                "rpc_tracker_key" : {
                  "allOf" : [ {
                    "type" : "string"
                  }, {
                    "title" : "RPC Tracker Key",
                    "description" : "Device key registered with the tracker. Example: raspberry-pi."
                  } ]
                },
                "rpc_session_timeout_sec" : {
                  "allOf" : [ {
                    "type" : "integer"
                  }, {
                    "title" : "RPC Session Timeout (s)",
                    "description" : "Maximum seconds per remote measurement session. Example: 60.",
                    "default" : 60,
                    "minimum" : 1
                  } ]
                }
              },
              "required" : [ "rpc_tracker_host", "rpc_tracker_port", "rpc_tracker_key" ],
              "default" : {
                "rpc_session_timeout_sec" : 60
              }
            },
            "else" : {
              "type" : "object",
              "properties" : {
                "tuning_runner_timeout_sec" : {
                  "allOf" : [ {
                    "type" : "number"
                  }, {
                    "title" : "Runner Timeout (s)",
                    "description" : "Maximum seconds to measure locally; RPC uses its session timeout. Example: 30.",
                    "default" : 30.0,
                    "exclusiveMinimum" : 0.0
                  } ]
                }
              },
              "default" : {
                "tuning_runner_timeout_sec" : 30.0
              }
            },
            "required" : [ "tuning_trials" ],
            "default" : {
              "allow_partial_tuning" : false,
              "max_trials_per_task" : 16,
              "tuning_trials_per_iter" : 64,
              "tuning_runner" : "local",
              "tuning_seed" : 0,
              "tuning_number" : 3,
              "tuning_repeat" : 1,
              "tuning_min_repeat_ms" : 100,
              "tuning_alloc_repeat" : 1,
              "tuning_enable_cpu_cache_flush" : false,
              "tuning_builder_timeout_sec" : 30.0
            }
          }, {
            "type" : "object",
            "properties" : {
              "tuning_model_path" : {
                "minLength" : 1,
                "allOf" : [ {
                  "allOf" : [ {
                    "type" : "string"
                  }, {
                    "title" : "Tuning Database Source",
                    "description" : "Compiled Model containing the tuning database; required with apply. Example: store://my-project/model/tvm-so/xinet-tuned:version."
                  } ]
                } ]
              },
              "tuning_ops" : {
                "title" : "Operator Names",
                "description" : "Optional filters on task names; empty tunes all. Example item: conv2d.",
                "type" : "array",
                "items" : {
                  "allOf" : [ {
                    "type" : "string"
                  }, {
                    "title" : "fields.tuningOps.item.title",
                    "description" : "fields.tuningOps.item.description"
                  } ]
                }
              },
              "allow_partial_tuning" : {
                "allOf" : [ {
                  "type" : "boolean"
                }, {
                  "title" : "Allow Partial Tuning",
                  "description" : "Allow incomplete task coverage, for quick tests only. Example: false.",
                  "default" : false
                } ]
              },
              "tuning_mode" : {
                "enum" : [ "apply" ]
              }
            },
            "required" : [ "tuning_model_path" ],
            "default" : {
              "allow_partial_tuning" : false
            }
          } ]
        }
      }
    }
  },
  "required" : [ "task" ],
  "title" : "specs.tvm+compile:run.title",
  "description" : "specs.tvm+compile:run.description",
  "allOf" : [ {
    "if" : {
      "required" : [ "target" ],
      "properties" : {
        "target" : {
          "minProperties" : 1
        }
      }
    },
    "then" : {
      "properties" : {
        "target_architecture" : {
          "const" : "auto"
        }
      }
    }
  }, {
    "type" : "object",
    "properties" : {
      "envs" : {
        "title" : "fields.envs.title",
        "description" : "fields.envs.description",
        "type" : "array",
        "items" : {
          "$ref" : "#/$defs/CoreEnv",
          "title" : "fields.envs.item.title",
          "description" : "fields.envs.item.description"
        }
      },
      "function" : {
        "type" : "string",
        "title" : "fields.function.title",
        "description" : "fields.function.description",
        "minLength" : 1
      },
      "profile" : {
        "type" : "string",
        "title" : "fields.profile.title",
        "description" : "fields.profile.description"
      },
      "resources" : {
        "$ref" : "#/$defs/CoreResource",
        "title" : "fields.resources.title",
        "description" : "fields.resources.description"
      },
      "secrets" : {
        "title" : "fields.secrets.title",
        "description" : "fields.secrets.description",
        "type" : "array",
        "items" : {
          "type" : "string",
          "title" : "fields.secrets.item.title",
          "description" : "fields.secrets.item.description"
        }
      },
      "volumes" : {
        "title" : "fields.volumes.title",
        "description" : "fields.volumes.description",
        "type" : "array",
        "items" : {
          "$ref" : "#/$defs/CoreVolume",
          "title" : "fields.volumes.item.title",
          "description" : "fields.volumes.item.description"
        }
      }
    },
    "required" : [ "function" ],
    "title" : "specs.tvm+compile.title",
    "description" : "specs.tvm+compile.description"
  } ]
}