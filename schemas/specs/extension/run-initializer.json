{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "FileRef" : {
      "type" : "object",
      "properties" : {
        "destination" : {
          "type" : "string",
          "title" : "fields.destination.title",
          "description" : "fields.destination.description",
          "pattern" : "^(/|/?[\\w.-]+(/[\\w.-]+)*)$"
        },
        "source" : {
          "type" : "string",
          "title" : "fields.source.title",
          "description" : "fields.source.description",
          "minLength" : 1,
          "pattern" : "^[a-zA-Z][a-zA-Z0-9+.-]*:(//([a-zA-Z0-9._~!$&'()*+,;=:%-]*@)?[a-zA-Z0-9._~!$&'()*+,;=:%-]*(:[0-9]*)?)?(/[a-zA-Z0-9._~!$&'()*+,;=:@%-]*)*(\\?[a-zA-Z0-9._~!$&'()*+,;=:@/?%-]*)?(#[a-zA-Z0-9._~!$&'()*+,;=:@/?%-]*)?$"
        }
      },
      "required" : [ "source" ]
    }
  },
  "type" : "object",
  "properties" : {
    "files" : {
      "title" : "fields.files.title",
      "description" : "fields.files.description",
      "type" : "array",
      "items" : {
        "$ref" : "#/$defs/FileRef",
        "title" : "fields.files.item.title",
        "description" : "fields.files.item.description"
      }
    }
  },
  "title" : "specs.run-initializer.title",
  "description" : "specs.run-initializer.description"
}