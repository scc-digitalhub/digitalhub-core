# Environment for running digitalhub-core on the host against the local Kind cluster.
# Sourced by run-core.sh. Can also be loaded by an IDE launch config (e.g. VS Code "envFile").
#
# "host.docker.internal" must resolve to the host BOTH from the host itself and from pods:
#  - on the host: add "127.0.0.1 host.docker.internal" to /etc/hosts (up.sh checks this)
#  - in the cluster: up.sh adds a CoreDNS "hosts" entry pointing to the host gateway IP

# --- core endpoint (injected into run pods as DHCORE_ENDPOINT) ---
DH_ENDPOINT=http://host.docker.internal:8080

# --- auth: basic auth enables token issuing for run pods ---
DH_AUTH_BASIC_USER=admin
DH_AUTH_BASIC_PASSWORD=admin

# --- kubernetes ---
KUBECONFIG=deploy/local/.kubeconfig
K8S_NAMESPACE=digitalhub
# no metrics-server in the minimal setup
K8S_ENABLE_METRICS=false
K8S_ENABLE_LOGS=true

# --- S3 (SeaweedFS), static credentials shared with run pods ---
S3_CREDENTIALS_PROVIDER=true
S3_ENDPOINT_URL=http://host.docker.internal:8333
S3_BUCKET=datalake
S3_PATH_STYLE_ACCESS=true
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY=dhcore
AWS_SECRET_KEY=dhcore-secret
FILES_DEFAULT_STORE=s3://datalake

# --- database: embedded H2 (file under ./data) ---
JDBC_URL=jdbc:h2:file:./data/db
